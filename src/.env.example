# Copy to src/.env (install.py does this for you). .env is git-ignored.
# Every line is optional: only the configurations named need it.

# Google AI Studio key: gemma4, grounded_gemma, grounded_gemma_linking
GOOGLE_API_KEY=

# Contact (email or URL) sent in the User-Agent of Wikidata requests
WDQS_CONTACT=

# Folder holding the BLINK models, if not .venv/src/blink/models: blink
BLINK_MODELS=

# Python of the geoparser environment, if not .venv-geoparser: geoparser_irchel
GEOPARSER_PYTHON=
