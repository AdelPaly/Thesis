src/geocorpora_144.csv


# Bluesky English dump (~380 MB, regenerate with scripts/fetch_bluesky_en.py)
generation/synthetic/data/bluesky_en.jsonl
generation/synthetic/data/bluesky_en.parquet
generation/synthetic/data/bluesky_en.jsonl.bak
# old location, until the copy there is deleted
src/bluesky_en.jsonl

# Runner checkpoint temporaries
results/predictions/*.tmp

# Dense retrieval index cache (embedding matrix)
src/.dense_index/

# Backups and superseded snapshots: kept on disk, not in git (git history is the
