# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments (python install.py)
.venv/
.venv-geoparser/
venv/

# IDE and local tool state
.idea/
*.iml
.claude/

# Secrets
.env
*.env

# Archives and backups never belong in the repo
*.zip
*.bak
*.bak-*
*.bak[0-9]*

# OS
.DS_Store
Thumbs.db

# Caches, rebuilt at run time
src/.wikidata_cache/
src/.llm_cache/
src/.dense_index/
src/.blink_cache/
src/*.pkl
generation/out/cache/

# Runner checkpoint temporaries
results/predictions/*.tmp

# Bluesky English dump (~380 MB, rebuild with scripts/fetch_bluesky_en.py)
generation/synthetic/data/bluesky_en.*
src/bluesky_en.jsonl

# Superseded plans, written by plan.py and validate_anchors.py
generation/synthetic/output/archive/
